{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci",
  "buildCommand": "npm exec --no-install -w frontend -- vite build",
  "outputDirectory": "frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://api.rwaindex.cn/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://api.rwaindex.cn/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}