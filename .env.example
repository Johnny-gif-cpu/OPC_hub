# ============================================================
# 楚楚智创 · OPC孵化器 — 环境变量示例
# 复制为 .env 后按需填写。零配置也能跑（DEV 模式）。
# ============================================================

# --- MongoDB 数据库 ---
# 生产环境必须配置。本地开发可用 localhost：
# MONGODB_URI=mongodb://127.0.0.1:27017/chuchu
# 生产用 MongoDB Atlas：
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/chuchu?retryWrites=true&w=majority

# --- 邮箱验证码（可选）---
# 不配置时：DEV 模式，验证码直接在页面显示 / 打印到后端控制台。
# 配置后：真实通过 Gmail 发送验证码邮件。
# GMAIL_USER=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-16-char-app-password

# --- 后端端口（可选，默认 4000）---
# PORT=4000

# --- CORS 允许的前端域名（生产环境设置）---
# 改为你的 Vercel 前端域名。留空或 * 表示允许所有来源（不安全）。
# CORS_ORIGIN=https://chuchu-opc.vercel.app

# --- 信任反向代理 IP 头（部署在 Nginx 后设为 true）---
# TRUST_PROXY=true
